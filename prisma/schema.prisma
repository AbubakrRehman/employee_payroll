// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String
  employees Employee[]
}

model Employee {
  id           Int          @id @default(autoincrement())
  name         String
  basicSalary  Decimal      @db.Decimal(10, 2)
  isActive     Boolean      @default(true)
  departmentId Int
  // Defines the foreign key relationship
  department   Department   @relation(fields: [departmentId], references: [id])
  attendance   Attendance[]
  payRollDetails PayrollDetail[]
}

model Attendance {
  id               Int @id @default(autoincrement())
  month            Int
  year             Int
  totalWorkingDays Int
  daysPresent      Int

  // Foreign Key setup
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  // Recommended: Prevents duplicate attendance records for the same employee in a given month
  @@unique([employeeId, month, year])
}


model PayrollRun {
  id Int      @id @default(autoincrement())
  month        Int
  year         Int
  runDate      DateTime @default(now())

  // Critical for the Bonus Feature: Prevents duplicate runs for the same period
  payrollDetails PayrollDetail[]
  @@unique([month, year])
}


model PayrollDetail {
  payrollDetailId Int     @id @default(autoincrement())
  
  // Snapshot Data (Enforces Immutability)
  basicSalary     Decimal @db.Decimal(10, 2)
  workingDays     Int
  daysPresent     Int
  grossPay        Decimal @db.Decimal(10, 2)
  pfDeduction     Decimal @db.Decimal(10, 2)
  professionalTax Decimal @db.Decimal(10, 2)
  netPay          Decimal @db.Decimal(10, 2)

  // Foreign Key setup for PayrollRun
  payrollRunId    Int
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id])

  // Foreign Key setup for Employee
  employeeId      Int
  employee        Employee   @relation(fields: [employeeId], references: [id])

  // Prevents generating multiple payslips for the same employee in a single run
  @@unique([payrollRunId, employeeId])
}